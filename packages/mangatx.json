{
      "sourceID": "mangatx-engine",
      "providerID": "mangatx-engine",

      "name": "MangaTX Engine Test",
      "version": "1.1.4",
      "language": "en",

      "websiteURL": "https://mangatx.cc",

      "searchURL": "https://mangatx.cc/manga-list?search={query}",
      "mangaDetailsURL": "{mangaURL}",
      "chapterListURL": "{mangaURL}",
      "pageListURL": "{chapterURL}",

     "latestURL": "https://mangatx.cc/manga-list?orderby=update",
"popularURL": "https://mangatx.cc/manga-list?genre=&type=&status=&order=popular",
"trendingURL": null,
"newMangaURL": null,
"topMangaURL": null,

      "parsingRules": {
              "search": {
                        "cardSelector": ".bsx a[href*='/manga/'], .listupd a[href*='/manga/'], .utao .uta a[href*='/manga/']",
                        "titleSelector": ".tt",
                        "coverSelector": "img",
                        "linkSelector": ""
              },

        "mangaDetails": {
                  "titleSelector": "h1",
                  "descriptionSelector": ".entry-content p",
                  "coverSelector": ".thumb img",
                  "authorSelector": ".tsinfo",
                  "artistSelector": ".tsinfo",
                  "statusSelector": ".tsinfo"
        },

              "chapters": {
                        "chapterSelector": ".eph-num a",
                        "titleSelector": ".chapternum",
                        "linkSelector": ""
              },

              "pages": {
                        "imageSelector": "#readerarea img"
              }
      }
}
